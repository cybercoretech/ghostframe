# Copy to .env and replace all example secrets before starting PhotoPrism.
PHOTOPRISM_ADMIN_USER=admin
PHOTOPRISM_ADMIN_PASSWORD=replace-with-a-long-unique-password
PHOTOPRISM_DATABASE_PASSWORD=replace-with-a-different-long-password
MARIADB_ROOT_PASSWORD=replace-with-another-long-password
PHOTOPRISM_SITE_URL=http://127.0.0.1:2342/
TZ=America/Los_Angeles
